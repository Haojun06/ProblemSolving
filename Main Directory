import os
import json
import sys
import math_quiz
import time 

users = {}
#load user data 
def load_data(file_path):
    try:
        with open(file_path, 'r') as file:
            return json.load(file)
    except FileNotFoundError:
        return {}

#save user data into json    
def save_data(file_path, data):
    with open(file_path, 'w') as file:
        json.dump(data, file, indent=4)

#clear terminal screen 
def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

#register new user data     
def register(): 
    clear_screen()
    print("REGISTER")
    username = input("Create username:")
    if username in users:
        print("This username is taken! Please create a new username. \n If it is you, try logging in.")
        input("Press ENTER to go back to main page...")
        return
    password = input("Create password:") 
    users[username] = password
    save_data("users_data.json", users)

    print ("Account created! Please log in.")
    time.sleep(2)
    login()
    return

