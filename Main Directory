#user log out
def logout(logged_in):
    clear_screen()
    if logged_in == None:
        print("Goodbye!")
        input("Press ENTER to continue...")
        sys.exit

#Game
def game():
   while True:
        clear_screen()
        print("Pick a game!")
        print("1.Math quiz")
        print("2.Random word")
        print("3.Number bomb")
        print("4.GO BACK TO MAIN PAGE")
        game_choice = input("Enter your choice(1-4):")
        
        if game_choice == "4": 
            main()

#Main
def main(): 
    data_file = "users_data.json"
    global users
    users = load_data(data_file)
    logged_in = None

    while True:
        clear_screen()
        print("Welcome to the game!")
        print("1.Register")
        print("2.Log in")
        print("3.Exit game")
        choice = input("Enter your choice(1-3):")
        
        if choice == "1":
            register()
        
        elif choice == "2":
            if logged_in == None:
                logged_in = login()

        elif choice == "3":
            print("Exiting game...")
            print("Goodbye!")
            time.sleep(2)
            sys.exit
            
        else:
            print("Invalid choice! Please try again.")
            time.sleep(1)
            main()
                    
if __name__ == "__main__":
    main()

